        "VERIFY_LEGACY_ROLLBACK_TARGET",
        "VERIFY_NEW_ARTIFACT_LINEAGE",
        "SIMULATE_BINDING_SWITCH",
        "SIMULATE_HEALTH_CHECK_FAILURE",
        "SIMULATE_ROLLBACK_TO_LEGACY",
        "VERIFY_POST_ROLLBACK_BASELINE"
