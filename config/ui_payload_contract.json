  "scope_semantics": {
    "portfolio": {
      "alignment": "ALL_ENABLED_SHOPS_COMMON_RELIABLE_INTERSECTION",
      "daily_shop_requirement": "ALL_ENABLED_SHOPS_PRESENT_EACH_DAY",
      "additive_fields": [
