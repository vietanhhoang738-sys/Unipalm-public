      "recomputed_ratios": {
        "placedAov": "placedGmv / placedOrders",
        "placedCvr": "placedOrders / productClicks",
        "roas": "adsAttributedSales / adsSpend",
        "totalPlatformCostRatio": "(orderFees + adsSpend) / netSalesAfterCancel"
