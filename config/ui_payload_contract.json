      "latest_complete_day_visible_label": "Ngày gần nhất",
      "partial_window_visible_policy": "LABEL_OBSERVED_DAYS_NOT_REQUESTED_HORIZON",
      "comparison_window_policy": "REQUIRE_COMPLETE_CURRENT_AND_PREVIOUS_WINDOWS"
    }
